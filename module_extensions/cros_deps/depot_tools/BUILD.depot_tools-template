load(
    "@rules_pkg//pkg:mappings.bzl",
    "pkg_attributes",
    "pkg_files",
    "strip_prefix"
)
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

pkg_files(
    name = "__files__",
    srcs = glob(
        [
            "*.py",
            "cipd",
            "cipd_*",
            "ninja",
            "python-bin/python3",
            "siso",
            "third_party/colorama/*.py",
            "third_party/repo/*.py",
            "third_party/schema/*.py",
            "vpython.toml",
            "vpython.toml.uv.lock",
            "vpython3",

            # Pulled by ensure_bootstrap.
            ".cipd_bin/.cipd_client_version",
            ".cipd_bin/.cipd_manifest.txt",
            ".cipd_bin/.cipd_manifest.versions",
            ".cipd_bin/3.*/**",
            ".cipd_bin/reclient/*",
            ".cipd_bin/uv/**",
            ".cipd_bin/vpython3",
            ".cipd_client",
            "bootstrap-*_bin/python3/**",
            "python3_bin_reldir.txt",
        ],
        exclude = [
            "**/__pycache__/**",
            ".git/**",
        ],
    ),
    attributes = pkg_attributes(
        mode = "0755",
    ),
    prefix = "/mnt/host/source/src/chromium/depot_tools/",
    strip_prefix = strip_prefix.from_pkg(),
    visibility = ["//visibility:private"],
)

pkg_tar(
    name = "src",
    srcs = [
        ":__files__",
    ],
    compressor = "@//bazel/portage/repo_defs/zstd:pzstd",
    extension = "tar.zst",
    visibility = [
        "@//bazel:internal",
        "@portage//:__subpackages__",
    ],
)
